{
  "name": "rhine-music-demo",
  "version": "0.3.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/export-records.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/export-records.mjs",
    "check:content": "node --experimental-strip-types --test scripts/check-content.mjs",
    "check:viewport": "node --experimental-strip-types scripts/check-viewport.mjs",
    "review:mobile": "node scripts/serve-mobile-review.mjs",
    "export:archives": "node scripts/export-records.mjs",
    "build": "tsc && vite build && node scripts/build-pwa.mjs",
    "format": "prettier --write src scripts index.html package.json tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "music": "node scripts/music-server.mjs",
    "check:music": "node scripts/check-music-chain.mjs"
  },
  "dependencies": {
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@chenglou/pretext": "^0.0.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@kitlangton/rolling-number": "0.4.1",
    "@xmldom/xmldom": "^0.9.12",
    "framer-motion": "^13.4.3",
    "lucide-react": "^1.48.0",
    "music-metadata": "^11.16.1",
    "opencc-js": "^1.4.2",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.183.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.183.0",
    "autoprefixer": "^10.6.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
